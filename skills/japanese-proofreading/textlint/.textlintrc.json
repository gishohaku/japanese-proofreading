{
  "plugins": {
    "@textlint/markdown": true,
    "@textlint/text": true,
    "review": true
  },
  "filters": {
    "comments": true
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 100
      },
      "max-ten": {
        "max": 3
      },
      "max-kanji-continuous-len": {
        "max": 6
      },
      "no-exclamation-question-mark": false,
      "ja-no-mixed-period": {
        "allowPeriodMarks": [
          "："
        ]
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "",
        "preferInList": "",
        "strict": false
      },
      "no-doubled-joshi": false,
      "arabic-kanji-numbers": false
    },
    "preset-jtf-style": {
      "1.1.3.箇条書き": false,
      "2.1.2.漢字": false,
      "2.1.5.カタカナ": false,
      "2.1.6.カタカナの長音": false,
      "2.2.1.ひらがなと漢字の使い分け": false,
      "3.1.1.全角文字と半角文字の間": false,
      "4.2.7.コロン(：)": false,
      "4.3.3.かぎかっこ「」": false,
      "1.1.1.本文": false
    },
    "prh": {
      "rulePaths": [
        "prh/house.yml",
        "prh/icsmedia_idiom.yml",
        "prh/icsmedia_duplicate.yml"
      ]
    },
    "@textlint-ja/no-synonyms": {
      "allowAlphabet": true,
      "allowNumber": true
    },
    "@textlint-ja/no-dropping-i": true,
    "date-weekday-mismatch": true
  }
}
